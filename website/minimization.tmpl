{% extends "templates/base.tmpl" %}
{% block title %}Minimization Benchmark{% endblock %}
{% block content %}
<h2>Minimization Benchmarks</h2>
Minimization benchmarks for optimization algorithms.

<h3><a id="lj38" href="#lj38">Random Lennard-Jones 38 Cluster</a></h3>

<p>This benchmark tests the performance of optimizers starting from 1000
randomly generated Lennard-Jones 38 clusters. A tar file containing the
structures is here: <a href="minimization/lj38/lj38-clusters.tgz">lj38.tgz</a>.</p>

<p>The maximum force on an atom must be reduced to at least 0.01 energy /
distance. The maximum number of force calls that may be made cannot exceed
10,000.</p>

<table class="sortable">
  <tr>
    <th>Algorithm</th>
    <th>Code</th>
    <th>&lt;FCs&gt;</th>
    <th>min(FCs)</th>
    <th>max(FCs)</th>
    <th>Failed</th>
    <th>FCs per sec</th>
    <th>Date</th>
    <th>Contributor</th>
  </tr>
  {% for entry in benchmarks['lj38'] %}
    <tr>
      <td>{{ entry.algorithm }}</td>
      <td>{{ entry.code }} {{ entry.code_version }}</td>
      <td>{{ '%.0f' % entry.force_calls|float }}</td>
      <td>{{ '%.0f' % entry.force_calls_min|float }}</td>
      <td>{{ '%.0f' % entry.force_calls_max|float }}</td>
      <td>{{ entry.nfailed }}</td>
      <td>{{ '%.0f' % entry.force_calls_per_second|float }}</td>
      <td>{{ entry.date }}</td>
      <td>{{ entry.contributor }}</td>
    </tr>
  {% endfor %}
</table>

{% endblock %}
