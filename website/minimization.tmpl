{% extends "templates/base.tmpl" %}
{% block title %}Minimization Benchmark{% endblock %}
{% block content %}
<h1>Minimization Benchmarks</h1>
Minimization benchmarks for optimization algorithms.

<h2>Random Lennard-Jones 38 Cluster</h2>

<p>This benchmark tests the performance of optimizers starting from 1000
randomly generated Lennard-Jones 38 clusters. A tar file containing the
structures is here: <a href="minimization/lj38/lj38-clusters.tgz">lj38.tgz</a>.</p>

<p>The maximum force on an atom must be reduced to at least 0.01 energy /
distance. The maximum number of force calls that may be made cannot exceed
10,000.</p>

{% set lj38_benchmarks = [ 
    {'directory':'eon-qm',   'algorithm':'Quick-min', 'code':'Eon' },
    {'directory':'eon-fire', 'algorithm':'FIRE', 'code':'Eon' } ,
    {'directory':'eon-cg', 'algorithm':'Conjugate-Gradients', 'code':'Eon' } ,
    {'directory':'eon-lbfgs', 'algorithm':'LBFGS', 'code':'Eon' } ,
    {'directory':'ase-lbfgs', 'algorithm':'LBFGS', 'code':'ASE' } ,
    {'directory':'ase-lbfgslinesearch', 'algorithm':'LBFGSLineSearch', 'code':'ASE' } ,
    {'directory':'ase-bfgslinesearch', 'algorithm':'BFGSLineSearch', 'code':'ASE' } ,
    {'directory':'ase-fire', 'algorithm':'FIRE', 'code':'ASE' } ,
    {'directory':'ase-mdmin', 'algorithm':'Quick-min', 'code':'ASE' } ,
    {'directory':'Alireza-bfgs', 'algorithm':'BFGS', 'code':'Alireza'}, 
    {'directory':'Alireza-fire', 'algorithm':'FIRE', 'code':'Alireza'}, 
    {'directory':'Alireza-sd', 'algorithm':'Steepest Descent', 'code':'Alireza'}, 
    {'directory':'Alireza-sdcg', 'algorithm':'Conjugate Gradients', 'code':'Alireza'}, 
    {'directory':'Nocedal-nlbfgs', 'algorithm':'LBFGS', 'code':'Nocedal'}, 
  ] 
%}

<table class="sortable">
  <tr>
    <th>Algorithm</th>
    <th>Code</th>
    <th>&lt;Force Calls&gt;</th>
    <th>min(Force Calls)</th>
    <th>max(Force Calls)</th>
    <th>Failed</th>
    <th>Force Calls/Second</th>
  </tr>
  {% for benchmark in lj38_benchmarks %}
    {% set path = "minimization/lj38/" + benchmark.directory + "/" %}
    <tr>
      <td>{{ benchmark.algorithm }}</td>
      <td>{{ benchmark.code }}</td>
      <td>{% include path+"force_calls.dat" %}</td>
      <td>{% include path+"force_calls_min.dat" %}</td>
      <td>{% include path+"force_calls_max.dat" %}</td>
      <td>{% include path+"nfailed.dat" %}</td>
      <td>{% include path+"force_calls_per_second.dat" %}</td>
    </tr>
  {% endfor %}
</table>

{% endblock %}
